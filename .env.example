# ══════════════════════════════════════════════════════════════════
# outpills — конфигурация окружения (DEV)
# Скопируй: cp .env.example .env
# ВСЕ значения ниже — placeholder-ы. Реальные секреты не коммитить!
# Production-шаблон: .env.production.example
# ══════════════════════════════════════════════════════════════════

# ── Режим ──
NODE_ENV=development
APP_ENV=development
PORT=4000

# ── Домены и URL (dev) ──
BASE_DOMAIN=localhost
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:4000/api
ADMIN_URL=http://localhost:3000/admin
CORS_ORIGINS=http://localhost:3000
# COOKIE_DOMAIN в dev не задаём (cookie на localhost)
COOKIE_DOMAIN=

# ── База данных ──
# connection_limit — пул на реплику; сумма по всем репликам < max_connections PG
# Порт 15432 — Docker-Postgres из docker-compose.yml (5432 может быть занят локальным PG)
DATABASE_URL=postgresql://outpills:outpills_dev@localhost:15432/outpills?connection_limit=10&pool_timeout=10

# ── Redis (кеш каталога; в scalable-проде — rate limit и сессии) ──
REDIS_URL=redis://localhost:6379

# ── Auth ──
JWT_SECRET=change_me_dev_jwt_secret
JWT_EXPIRES_IN=7d
SESSION_SECRET=change_me_dev_session_secret

# ── Object storage (изображения товаров) ──
# dev: MinIO из docker-compose; prod: любой S3-совместимый + CDN
STORAGE_TYPE=s3
STORAGE_BUCKET=outpills-media
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=outpills
STORAGE_SECRET_KEY=outpills_dev_secret
# База публичных URL картинок (в проде сюда ставится CDN-домен)
STORAGE_PUBLIC_URL=http://localhost:9000/outpills-media

# ── Платежи ──
# Провайдер не выбран: работает mock. Потом: cloudpayments | robokassa
PAYMENT_PROVIDER=mock
PAYMENT_SUCCESS_URL=http://localhost:3000/checkout/success
PAYMENT_FAIL_URL=http://localhost:3000/checkout/fail
PAYMENT_RETURN_URL=http://localhost:3000/checkout
PAYMENT_WEBHOOK_SECRET=change_me_webhook_secret
PAYMENT_IDEMPOTENCY_SECRET=change_me_idempotency_secret

# Заготовки под будущих провайдеров (не заполнять, пока не подключаем):
# CLOUDPAYMENTS_PUBLIC_ID=
# CLOUDPAYMENTS_API_SECRET=
# ROBOKASSA_MERCHANT_LOGIN=
# ROBOKASSA_PASSWORD_1=
# ROBOKASSA_PASSWORD_2=

# ── Заказы и склад ──
# Сколько минут держим резерв товара до оплаты
RESERVATION_TTL_MINUTES=30

# ── Rate limiting ──
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX_REQUESTS=300

# ── Разное ──
BODY_LIMIT=1mb
# 1 — реплика выполняет фоновые задачи (снятие резервов); 0 — нет
RUN_WORKERS=1

# ── Seed (только dev) ──
SEED_ADMIN_EMAIL=admin@outpills.local
SEED_ADMIN_PASSWORD=outpills-admin-dev
