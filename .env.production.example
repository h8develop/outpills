# ══════════════════════════════════════════════════════════════════
# outpills — PRODUCTION-конфигурация
# Скопируй на сервер: cp .env.production.example .env.production
# Заполни ВСЕ значения. Файл .env.production никогда не коммитится.
# Секреты генерируй так: openssl rand -hex 32
# ══════════════════════════════════════════════════════════════════

# ── Режим ──
NODE_ENV=production
APP_ENV=production
PORT=4000

# ── Домены и URL ──
# Пример структуры: outpills.com | www | api.outpills.com | admin — путём /admin
BASE_DOMAIN=example.com
FRONTEND_URL=https://example.com
API_URL=https://api.example.com/api
ADMIN_URL=https://example.com/admin
CORS_ORIGINS=https://example.com,https://www.example.com
# Точка в начале — cookie делится между поддоменами (site + api)
COOKIE_DOMAIN=.example.com
# Email для Let's Encrypt (Caddy)
ACME_EMAIL=admin@example.com

# ── PostgreSQL (контейнер db из docker-compose.prod.yml) ──
POSTGRES_USER=outpills
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=outpills
DATABASE_URL=postgresql://outpills:REPLACE_WITH_STRONG_PASSWORD@db:5432/outpills?connection_limit=10&pool_timeout=10

# ── Redis ──
REDIS_URL=redis://redis:6379

# ── Auth ──
JWT_SECRET=REPLACE_openssl_rand_hex_32
JWT_EXPIRES_IN=7d
SESSION_SECRET=REPLACE_openssl_rand_hex_32

# ── Object storage ──
# Вариант A (MVP): MinIO на этом же сервере (контейнер minio)
# Вариант B (рекомендуется для роста): managed S3 (Selectel/VK/Yandex/Timeweb S3) + CDN
STORAGE_TYPE=s3
STORAGE_BUCKET=outpills-media
STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=ru-1
STORAGE_ACCESS_KEY=REPLACE_ACCESS_KEY
STORAGE_SECRET_KEY=REPLACE_SECRET_KEY
# Публичная база URL картинок. MVP: https://media.example.com
# С CDN: https://cdn.example.com (CDN смотрит на media-домен или бакет)
STORAGE_PUBLIC_URL=https://media.example.com

# ── Платежи ──
# Пока провайдер не выбран — mock. После выбора: cloudpayments | robokassa
PAYMENT_PROVIDER=mock
PAYMENT_SUCCESS_URL=https://example.com/checkout/success
PAYMENT_FAIL_URL=https://example.com/checkout/fail
PAYMENT_RETURN_URL=https://example.com/checkout
PAYMENT_WEBHOOK_SECRET=REPLACE_openssl_rand_hex_32
PAYMENT_IDEMPOTENCY_SECRET=REPLACE_openssl_rand_hex_32

# CLOUDPAYMENTS_PUBLIC_ID=
# CLOUDPAYMENTS_API_SECRET=
# ROBOKASSA_MERCHANT_LOGIN=
# ROBOKASSA_PASSWORD_1=
# ROBOKASSA_PASSWORD_2=

# ── Заказы и склад ──
RESERVATION_TTL_MINUTES=30

# ── Rate limiting ──
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX_REQUESTS=300

# ── Разное ──
BODY_LIMIT=1mb
RUN_WORKERS=1
